# Copy to .env (never commit). Used only on the operator machine.

# Runpod control plane — create at https://console.runpod.io/user/settings
RUNPOD_API_KEY=

# Hugging Face — gated / higher-rate downloads. Never put this on a public pod env.
HF_TOKEN=

# Inference API key you generate. Required even on the SSH tunnel.
GLM_API_KEY=

# Live instance — never copy these into tracked markdown.
RUNPOD_POD_ID=
RUNPOD_TEMPLATE_ID=
RUNPOD_VOLUME_ID=
RUNPOD_DATACENTER=
SSH_HOST=
SSH_PORT=

# Laptop bind for scripts/ssh-tunnel.sh. Pod still listens on 8000 / 8428.
# 18000 / 18428 avoid clashing with local uvicorn/django/dev servers on :8000.
LOCAL_PORT=18000
REMOTE_PORT=8000
VM_LOCAL_PORT=18428
VM_REMOTE_PORT=8428

# Openrouter API key
OPENROUTER_API_KEY=
